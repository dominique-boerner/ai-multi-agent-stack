# AI Multi-Agent Stack - Environment Variables

# The port where your Express Server should run
PORT=3000

# Your Google Gemini API Key
# You can generate a free key in Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-api-key-here"

# Your Anthropic (Claude) API Key
# Optional: Only needed if you switch the provider to "anthropic" in the config
ANTHROPIC_API_KEY="your-api-key-here"

# Your Local Ollama API URL
# Default is usually http://127.0.0.1:11434
# Optional: Only needed if you switch the provider to "ollama" and host it non-locally
OLLAMA_BASE_URL="http://127.0.0.1:11434"